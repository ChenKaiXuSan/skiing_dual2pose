include README.md LICENSE requirements.txt pyproject.toml
recursive-include configs *.yaml
recursive-include pegasus/runtime/manifests *.json
recursive-include pegasus/runtime requirements-*.txt *.sh
global-exclude __pycache__ *.py[cod]
prune paper
prune reports
prune logs
prune unity
prune SAM3Dbody
prune .git
prune .cache
prune tests
