\label{tab:gate_region_summary}
\footnotesize
\setlength{\tabcolsep}{6pt}
\renewcommand{\arraystretch}{1.08}
\begin{tabular}{lccc}
\toprule
Region & Joints & \(\alpha\) & \(1-\alpha\) \\
\midrule
Upper limbs & 6 & \(0.497 \pm 0.004\) & 0.503 \\
Lower limbs & 6 & \(0.502 \pm 0.014\) & 0.498 \\
All joints & 15 & \(0.497 \pm 0.011\) & 0.503 \\
\bottomrule
\end{tabular}
