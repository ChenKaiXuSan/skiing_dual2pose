    "unity": (
        DATA_ROOT
        / "skiing_unity_dataset"
        / "data_pole_ski"
        / "female"
        / "Anim_Female_Skier_Skiing"
        / "frames"
        / "capture_L3_A000"
        / "frame_000036.png",
        DATA_ROOT
        / "skiing_unity_dataset"
        / "data_pole_ski"
        / "female"
        / "Anim_Female_Skier_Skiing"
        / "frames"
        / "capture_L3_A210"
        / "frame_000036.png",
    ),
    "ski_ptz": (
        DATA_ROOT
        / "Ski-PosePTZ-CameraDataset-png"
        / "data"
        / "test"
        / "seq_412"
        / "cam_02"
        / "image_000075.png",
        DATA_ROOT
        / "Ski-PosePTZ-CameraDataset-png"
        / "data"
        / "test"
        / "seq_412"
        / "cam_03"
        / "image_000075.png",
    ),
    "author": (
        DATA_ROOT
        / "sam3d_body_results"
